# Required application secrets
JUGG_SECRET_KEY=replace-with-existing-encryption-key
SIMPLE_OPEN_API_SECRET=replace-with-a-long-random-secret
MAGIC_API_SECRET_KEY=replace-with-a-long-random-secret

# Production database
SHKB_DB_URL=jdbc:mysql://mysql:3306/shkb_platform?useUnicode=true&characterEncoding=UTF-8&serverTimezone=GMT%2B8
SHKB_DB_USERNAME=shkb
SHKB_DB_PASSWORD=replace-me

# Production Redis and RabbitMQ
SHKB_REDIS_HOST=redis
SHKB_REDIS_PORT=6379
SHKB_REDIS_DATABASE=0
SHKB_REDIS_PASSWORD=replace-me
SHKB_RABBITMQ_ADDRESSES=rabbitmq:5672
SHKB_RABBITMQ_VHOST=/
SHKB_RABBITMQ_USERNAME=shkb
SHKB_RABBITMQ_PASSWORD=replace-me

# Public URL and persistent storage
SHKB_UPLOAD_DOMAIN=https://erp.example.com
SHKB_UPLOAD_DIR=/opt/data/upload
SHKB_TMP_DIR=/opt/data/tmp

# Keep disabled until mysqldump exists and a restore drill has passed.
MYSQL_BACKUP_ENABLED=false
MYSQL_BACKUP_DIR=/opt/data/backup/mysql
MYSQL_BACKUP_RETAIN_DAYS=7
