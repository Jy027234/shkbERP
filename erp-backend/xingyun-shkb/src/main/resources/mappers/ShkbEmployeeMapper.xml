    <select id="getDetail" resultMap="GetResultMap">
        SELECT
            t.id,
            t.code,
            t.name,
            t.gender,
            CASE
                WHEN t.gender = 1 THEN '男'
                WHEN t.gender = 2 THEN '女'
                ELSE '未知'
            END AS genderText,
            t.id_card,
            DATE_FORMAT(t.birthday, '%Y-%m-%d') AS birthday,
            t.nation,
            t.native_place,
            t.political_status,
            t.education,
            t.major,
            t.graduate_school,
            DATE_FORMAT(t.graduate_date, '%Y-%m-%d') AS graduateDate,
            t.phone,
            t.email,
            t.dept_id,
            d.name AS deptName,
            t.position,
            DATE_FORMAT(t.entry_date, '%Y-%m-%d') AS entryDate,
            DATE_FORMAT(t.regular_date, '%Y-%m-%d') AS regularDate,
            DATE_FORMAT(t.leave_date, '%Y-%m-%d') AS leaveDate,
            t.leave_reason,
            t.status,
            CASE
                WHEN t.status = 0 THEN '离职'
                WHEN t.status = 1 THEN '在职'
                WHEN t.status = 2 THEN '试用期'
                ELSE ''
            END AS statusText,
            t.photo_url,
            t.address,
            t.emergency_contact,
            t.emergency_phone,
            t.description,
            t.create_by,
            DATE_FORMAT(t.create_time, '%Y-%m-%d %H:%i:%s') AS createTime
        FROM shkb_employee t
        LEFT JOIN sys_dept d ON t.dept_id = d.id
        WHERE t.id = #{id}
    </select>
