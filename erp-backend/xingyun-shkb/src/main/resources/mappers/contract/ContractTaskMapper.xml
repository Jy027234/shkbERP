        LEFT JOIN
            base_data_product p ON ctnpp.product_id = p.id
        LEFT JOIN
            base_data_machine_type mt ON p.machine_type_id = mt.id
        LEFT JOIN
            tbl_product_stock ps ON ctnpp.product_id = ps.product_id AND ps.sc_id = #{scId}
        WHERE
