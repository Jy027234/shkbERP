<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lframework.xingyun.shkb.mappers.MaterialOrderDetailMapper">

    <resultMap id="BaseResultMap" type="com.lframework.xingyun.shkb.entity.MaterialOrderDetail">
            <id property="id" column="id" jdbcType="VARCHAR"/>
            <result property="orderId" column="order_id" jdbcType="VARCHAR"/>
            <result property="productId" column="product_id" jdbcType="VARCHAR"/>
            <result property="taxPrice" column="tax_price" jdbcType="DECIMAL"/>
            <result property="taxAmount" column="tax_amount" jdbcType="DECIMAL"/>
            <result property="description" column="description" jdbcType="VARCHAR"/>
            <result property="outNum" column="out_num" jdbcType="INTEGER"/>
            <result property="orderNum" column="order_num" jdbcType="INTEGER"/>
            <result property="oriBundleDetailId" column="ori_bundle_detail_id" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,order_id,product_id,
        tax_price,tax_amount,description,
        out_num,order_num,ori_bundle_detail_id
    </sql>

    <select id="selectByIdForUpdate" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM shkb_material_order_detail
        WHERE id = #{id}
        FOR UPDATE
    </select>

    <update id="addOutNum">
        UPDATE shkb_material_order_detail
        SET out_num = out_num + #{outNum}
        WHERE id = #{id}
          AND out_num + #{outNum} &lt;= order_num
    </update>
</mapper>
