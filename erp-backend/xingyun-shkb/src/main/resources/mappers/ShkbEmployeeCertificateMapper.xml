<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lframework.xingyun.shkb.mappers.ShkbEmployeeCertificateMapper">

    <resultMap id="BaseResultMap" type="com.lframework.xingyun.shkb.entity.ShkbEmployeeCertificate">
            <id property="id" column="id" jdbcType="VARCHAR"/>
            <result property="employeeId" column="employee_id" jdbcType="VARCHAR"/>
            <result property="certificateType" column="certificate_type" jdbcType="VARCHAR"/>
            <result property="certificateName" column="certificate_name" jdbcType="VARCHAR"/>
            <result property="certificateNo" column="certificate_no" jdbcType="VARCHAR"/>
            <result property="issueOrg" column="issue_org" jdbcType="VARCHAR"/>
            <result property="issueDate" column="issue_date" jdbcType="DATE"/>
            <result property="validStartDate" column="valid_start_date" jdbcType="DATE"/>
            <result property="validEndDate" column="valid_end_date" jdbcType="DATE"/>
            <result property="status" column="status" jdbcType="TINYINT"/>
            <result property="fileUrl" column="file_url" jdbcType="VARCHAR"/>
            <result property="description" column="description" jdbcType="VARCHAR"/>
            <result property="createBy" column="create_by" jdbcType="VARCHAR"/>
            <result property="createById" column="create_by_id" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="VARCHAR"/>
            <result property="updateById" column="update_by_id" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,employee_id,certificate_type,
        certificate_name,certificate_no,issue_org,
        issue_date,valid_start_date,valid_end_date,
        status,file_url,description,
        create_by,create_by_id,create_time,
        update_by,update_by_id,update_time
    </sql>

    <resultMap id="QueryResultMap" type="com.lframework.xingyun.shkb.bo.certificate.QueryShkbEmployeeCertificateBo">
        <id property="id" column="id"/>
        <result property="employeeId" column="employee_id"/>
        <result property="employeeName" column="employee_name"/>
        <result property="certificateType" column="certificate_type"/>
        <result property="certificateName" column="certificate_name"/>
        <result property="certificateNo" column="certificate_no"/>
        <result property="issueOrg" column="issue_org"/>
        <result property="issueDate" column="issueDate"/>
        <result property="validStartDate" column="validStartDate"/>
        <result property="validEndDate" column="validEndDate"/>
        <result property="status" column="status"/>
        <result property="statusText" column="statusText"/>
        <result property="fileUrl" column="file_url"/>
        <result property="description" column="description"/>
    </resultMap>

    <select id="query" resultMap="QueryResultMap">
        SELECT
            t.id,
            t.employee_id,
            e.name AS employee_name,
            t.certificate_type,
            t.certificate_name,
            t.certificate_no,
            t.issue_org,
            DATE_FORMAT(t.issue_date, '%Y-%m-%d') AS issueDate,
            DATE_FORMAT(t.valid_start_date, '%Y-%m-%d') AS validStartDate,
            DATE_FORMAT(t.valid_end_date, '%Y-%m-%d') AS validEndDate,
            t.status,
            CASE
                WHEN t.status = 0 THEN '过期'
                WHEN t.status = 1 THEN '有效'
                ELSE ''
            END AS statusText,
            t.file_url,
            t.description
        FROM shkb_employee_certificate t
        LEFT JOIN shkb_employee e ON t.employee_id = e.id
        <where>
            <if test="vo.keyword != null and vo.keyword != ''">
                AND (t.certificate_name LIKE CONCAT('%', #{vo.keyword}, '%')
                    OR t.certificate_no LIKE CONCAT('%', #{vo.keyword}, '%')
                    OR e.name LIKE CONCAT('%', #{vo.keyword}, '%'))
            </if>
            <if test="vo.certificateType != null and vo.certificateType != ''">
                AND t.certificate_type = #{vo.certificateType}
            </if>
            <if test="vo.certificateName != null and vo.certificateName != ''">
                AND t.certificate_name LIKE CONCAT('%', #{vo.certificateName}, '%')
            </if>
            <if test="vo.status != null">
                AND t.status = #{vo.status}
            </if>
        </where>
        ORDER BY t.create_time DESC
    </select>
</mapper>
