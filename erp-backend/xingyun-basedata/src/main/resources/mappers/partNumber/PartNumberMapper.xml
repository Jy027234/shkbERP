<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lframework.xingyun.basedata.mappers.PartNumberMapper">

    <resultMap id="BaseResultMap" type="com.lframework.xingyun.basedata.entity.PartNumber">
            <id property="id" column="id" jdbcType="VARCHAR"/>
            <result property="code" column="code" jdbcType="VARCHAR"/>
            <result property="name" column="name" jdbcType="VARCHAR"/>
            <result property="available" column="available" jdbcType="TINYINT"/>
            <result property="description" column="description" jdbcType="VARCHAR"/>
            <result property="createBy" column="create_by" jdbcType="VARCHAR"/>
            <result property="createById" column="create_by_id" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="VARCHAR"/>
            <result property="updateById" column="update_by_id" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="machineTypeId" column="machine_type_id" jdbcType="VARCHAR"/>
    </resultMap>
    
    <resultMap id="QueryBOResultMap" type="com.lframework.xingyun.basedata.bo.partNumber.QueryPartNumberBo">
            <id property="id" column="id" jdbcType="VARCHAR"/>
            <result property="code" column="code" jdbcType="VARCHAR"/>
            <result property="name" column="name" jdbcType="VARCHAR"/>
            <result property="available" column="available" jdbcType="TINYINT"/>
            <result property="description" column="description" jdbcType="VARCHAR"/>
            <result property="createBy" column="create_by" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="machineTypeId" column="machine_type_id" jdbcType="VARCHAR"/>
            <result property="machineTypeName" column="machine_type_name" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,code,name,
        available,description,create_by,
        create_by_id,create_time,update_by,
        update_by_id,update_time,machine_type_id
    </sql>
    
    <sql id="PartNumber_sql">
        SELECT
            tb.*,
            mt.name AS machine_type_name
        FROM base_data_part_number AS tb
        LEFT JOIN base_data_machine_type AS mt ON tb.machine_type_id = mt.id
    </sql>
    
    <select id="query" resultType="com.lframework.xingyun.basedata.bo.partNumber.QueryPartNumberBo">
        <include refid="PartNumber_sql"/>
        <where>
            <if test="vo != null">
                <if test="vo.code != null and vo.code != ''">
                    AND tb.code = #{vo.code}
                </if>
                <if test="vo.name != null and vo.name != ''">
                    AND tb.name LIKE CONCAT('%', #{vo.name}, '%')
                </if>
                <if test="vo.available != null">
                    AND tb.available = #{vo.available}
                </if>
                <if test="vo.machineTypeId != null and vo.machineTypeId != ''">
                    AND tb.machine_type_id = #{vo.machineTypeId}
                </if>
            </if>
        </where>
        ORDER BY tb.code
    </select>
    
    <select id="selector" resultType="com.lframework.xingyun.basedata.bo.partNumber.PartNumberSelectorBo">
        <include refid="PartNumber_sql"/>
        <where>
            <if test="vo != null">
                <if test="vo.code != null and vo.code != ''">
                    AND tb.code = #{vo.code}
                </if>
                <if test="vo.name != null and vo.name != ''">
                    AND tb.name LIKE CONCAT('%', #{vo.name}, '%')
                </if>
                <if test="vo.available != null">
                    AND tb.available = #{vo.available}
                </if>
                <if test="vo.machineTypeId != null and vo.machineTypeId != ''">
                    AND tb.machine_type_id = #{vo.machineTypeId}
                </if>
            </if>
        </where>
        ORDER BY tb.code
    </select>

    <select id="getPartNumberDetail" resultType="com.lframework.xingyun.basedata.bo.partNumber.GetPartNumberBo">
        SELECT
            pn.*,
            mt.code as machineTypeCode,
            mt.name as machineTypeName
        FROM
            base_data_part_number pn
                LEFT JOIN
            base_data_machine_type mt ON pn.machine_type_id = mt.id
        WHERE
            pn.id = #{id}
    </select>
</mapper>
